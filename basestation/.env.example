# Replace with the rover's static LAN IP before starting the production stack.
ROVER_DISCOVERY_SERVER=192.168.1.20:11811

# Replace with the base station's static LAN IP. MediaMTX advertises this
# address to remote browsers for WebRTC ICE connectivity.
MEDIA_WEBRTC_ADDITIONAL_HOSTS=192.168.1.10

# Operator GUIs are served locally on each PC by default.
MEDIA_WEBRTC_ALLOW_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
