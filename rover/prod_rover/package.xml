<?xml version="1.0"?>
<package format="3">
  <name>prod_rover</name>
  <version>0.1.0</version>
  <description>C++ ROS 2 production rover implementation.</description>
  <maintainer email="robotics@example.com">Deakin Competitive Robotics Club</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>controller_manager_msgs</depend>
  <depend>dcr_arm_driver</depend>
  <depend>ecam_alerts</depend>
  <depend>rclcpp</depend>
  <depend>rosidl_default_runtime</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>telemetry_interfaces</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export><build_type>ament_cmake</build_type></export>
</package>
