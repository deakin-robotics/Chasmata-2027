<?xml version="1.0"?>
<robot name="robot_arm">
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.050" radius="0.1"/>
            </geometry>
        </visual>   
    </link>
    <joint name="base_joint" type="revolute">
        <parent link="base_link"/>
        <child link="base_rot"/>
        <origin xyz="0 0 0.05" rpy="0 0 0" />
        <axis xyz="0 0 -1"/>
        <limit lower="-3.2288" upper="3.2288" effort="100" velocity="1.0"/>
    </joint>
    <link name="base_rot">
        <visual>
            <origin xyz="0 0 0.035" rpy="0 0 0" />
            <geometry>
                <box size="0.1 0.1 0.07" />
            </geometry>
        </visual>   
    </link>
    <joint name="shoulder_joint" type="revolute">
        <parent link="base_rot"/>
        <child link="arm1"/>
        <origin xyz="0 0 0.07" rpy="-1.57 0 0" />
        <axis xyz="1 0 0"/>
        <limit lower="-0.0873" upper="3.2288" effort="100" velocity="1.0"/>
    </joint>
    <link name="arm1">
        <visual>
            <origin xyz="0 0 0.25" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.5" radius="0.02"/>
            </geometry>
        </visual>   
    </link>
    <joint name="elbow_joint" type="revolute">
        <parent link="arm1"/>
        <child link="arm2"/>
        <origin xyz="0.08 0 0.5" rpy="3.14 0 0" />
        <axis xyz="-1 0 0"/>
        <limit lower="-0.0873" upper="4.7997" effort="100" velocity="1.0"/>
    </joint>
    <link name="arm2">
        <visual>
            <origin xyz="0 0 0.25" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.55" radius="0.02"/>
            </geometry>
        </visual>   
    </link>
    <joint name="j4_pivot_joint" type="fixed">
        <parent link="arm2"/>
        <child link="j4_pivot_link"/>
        <origin xyz="0 0.05 0.6" rpy="0 0 0"/>
    </joint>
    <link name="j4_pivot_link"/>

    <joint name="yaw_joint" type="revolute">
        <parent link="j4_pivot_link"/>
        <child link="yaw"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-1.6581" upper="3.2288" effort="100" velocity="1.0"/>
    </joint>
    <link name="yaw">
        <visual>
            <geometry><box size="0.05 0.05 0.05"/></geometry>
        </visual>
    </link>

    <joint name="pitch_joint" type="revolute">
        <parent link="yaw"/>
        <child link="pitch"/>
        <origin xyz="-0.05 0.05 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.0873" upper="3.7525" effort="100" velocity="1.0"/>
    </joint>
    <link name="pitch">
        <visual>
            <geometry><box size="0.05 0.05 0.05"/></geometry>
        </visual>
    </link>

    <joint name="roll_joint" type="revolute">
        <parent link="pitch"/>
        <child link="roll"/>
        <origin xyz="0 0 -0.075" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.2288" upper="3.2288" effort="100" velocity="1.0"/>
    </joint>
    <link name="roll">
        <visual>
            <geometry><box size="0.05 0.05 0.05"/></geometry>
        </visual>
    </link>

    <joint name="ee_joint" type="fixed">
        <parent link="roll"/>
        <child link="ee_link"/>
        <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    </joint>
    <link name="ee_link">
        <visual>
            <origin xyz="0 0 0.025" rpy="0 0 0" />
            <geometry>
                <box size="0.1 0.1 0.05" />
            </geometry>
        </visual>
    </link>

    <!-- ROS2 Control Interface -->
    <ros2_control name="ArmController" type="system">
        <hardware>
            <plugin>dcr_arm_driver/ArmHardwareInterface</plugin>
            <param name="can_interface">can0</param>
            <param name="base_joint_can_id">0x01</param>
            <param name="shoulder_joint_can_id">0x02</param>
            <param name="elbow_joint_can_id">0x03</param>
            <param name="yaw_joint_can_id">0x04</param>
            <param name="pitch_joint_can_id">0x05</param>
            <param name="roll_joint_can_id">0x06</param>
        </hardware>
        <joint name="base_joint">
            <command_interface name="position">
                <param name="min">-3.2288</param>
                <param name="max">3.2288</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="shoulder_joint">
            <command_interface name="position">
                <param name="min">-0.0873</param>
                <param name="max">3.2288</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="elbow_joint">
            <command_interface name="position">
                <param name="min">-0.0873</param>
                <param name="max">4.7997</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="yaw_joint">
            <command_interface name="position">
                <param name="min">-1.6581</param>
                <param name="max">3.2288</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="pitch_joint">
            <command_interface name="position">
                <param name="min">-0.0873</param>
                <param name="max">3.7525</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="roll_joint">
            <command_interface name="position">
                <param name="min">-3.2288</param>
                <param name="max">3.2288</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>
</robot>
