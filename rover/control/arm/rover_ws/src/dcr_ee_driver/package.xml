<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dcr_ee_driver</name>
  <version>0.0.1</version>
  <description>Standalone end effector driver for the DCR arm, using CAN communication via nobleo_socketcan_bridge (not ros2_control)</description>
  <maintainer email="forrest.nguyen27@gmail.com">Forrest Nguyen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>can_msgs</depend>
  <depend>arm_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
