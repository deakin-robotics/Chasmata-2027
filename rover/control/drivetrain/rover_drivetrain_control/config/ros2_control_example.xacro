<?xml version="1.0"?>
<!-- CONFIGURATION TEMPLATE ONLY, NOT A COMPLETED ROBOT DESCRIPTION.
     Do not include this unchanged into a real robot: serial device, mapping,
     gearbox, RPM limit, timings and measurements must be supplied explicitly.
     Intended integration with existing team-generated URDF (not replacing it).
     The plugin WILL REFUSE on_configure() pending hardware verification.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="dcr_drivetrain_hardware" params="left_device right_device left_baud right_baud parity data_bits stop_bits update_hz upstream_timeout_ms stop_deadline_ms measured_stop_wire_budget_ms measured_worst_bus_cycle_ms late_trigger_ms fl_id rl_id fr_id rr_id gear_ratio motor_rpm_limit">
    <ros2_control name="DCRDrivetrain" type="system">
      <hardware>
        <plugin>rover_drivetrain_control/RoverHardwareInterface</plugin>
        <param name="is_async">true</param>
        <param name="rw_rate">${update_hz}</param>
        <param name="left_serial_device">${left_device}</param>
        <param name="right_serial_device">${right_device}</param>
        <param name="left_baud_rate">${left_baud}</param>
        <param name="right_baud_rate">${right_baud}</param>
        <param name="left_parity">${parity}</param>
        <param name="right_parity">${parity}</param>
        <param name="left_data_bits">${data_bits}</param>
        <param name="right_data_bits">${data_bits}</param>
        <param name="left_stop_bits">${stop_bits}</param>
        <param name="right_stop_bits">${stop_bits}</param>
        <param name="update_hz">${update_hz}</param>
        <param name="upstream_timeout_ms">${upstream_timeout_ms}</param>
        <param name="stop_deadline_ms">${stop_deadline_ms}</param>
        <param name="measured_stop_wire_budget_ms">${measured_stop_wire_budget_ms}</param>
        <param name="measured_worst_bus_cycle_ms">${measured_worst_bus_cycle_ms}</param>
        <param name="late_trigger_ms">${late_trigger_ms}</param>
      </hardware>
      <joint name="front_left_wheel_joint">
        <param name="bus">left</param><param name="slave_id">${fl_id}</param>
        <param name="gear_ratio">${gear_ratio}</param><param name="motor_rpm_limit">${motor_rpm_limit}</param><param name="mirrored">false</param>
        <command_interface name="velocity"/><state_interface name="velocity"/>
      </joint>
      <joint name="rear_left_wheel_joint">
        <param name="bus">left</param><param name="slave_id">${rl_id}</param>
        <param name="gear_ratio">${gear_ratio}</param><param name="motor_rpm_limit">${motor_rpm_limit}</param><param name="mirrored">false</param>
        <command_interface name="velocity"/><state_interface name="velocity"/>
      </joint>
      <joint name="front_right_wheel_joint">
        <param name="bus">right</param><param name="slave_id">${fr_id}</param>
        <param name="gear_ratio">${gear_ratio}</param><param name="motor_rpm_limit">${motor_rpm_limit}</param><param name="mirrored">true</param>
        <command_interface name="velocity"/><state_interface name="velocity"/>
      </joint>
      <joint name="rear_right_wheel_joint">
        <param name="bus">right</param><param name="slave_id">${rr_id}</param>
        <param name="gear_ratio">${gear_ratio}</param><param name="motor_rpm_limit">${motor_rpm_limit}</param><param name="mirrored">true</param>
        <command_interface name="velocity"/><state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
