FROM ros:jazzy-ros-base

SHELL ["/bin/bash", "-c"]
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential libmodbus-dev pkg-config python3-colcon-common-extensions python3-yaml \
        ros-jazzy-ament-cmake-gtest ros-jazzy-control-msgs ros-jazzy-controller-manager-msgs \
        ros-jazzy-ros2-control ros-jazzy-diff-drive-controller \
        ros-jazzy-forward-command-controller ros-jazzy-joint-state-broadcaster \
        ros-jazzy-robot-state-publisher ros-jazzy-xacro ros-jazzy-launch-xml \
        ros-jazzy-rosbridge-server ros-jazzy-rosidl-default-generators \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY interfaces/telemetry_interfaces /workspace/src/telemetry_interfaces
COPY rover/shared/ecam_alerts /workspace/src/ecam_alerts
COPY rover/rover /workspace/src/rover
COPY rover/control/drivetrain/rover_drivetrain_interfaces /workspace/src/rover_drivetrain_interfaces
COPY rover/control/drivetrain/rover_drivetrain_control /workspace/src/rover_drivetrain_control
RUN source /opt/ros/jazzy/setup.bash && colcon build --symlink-install

ENTRYPOINT ["/bin/bash", "/workspace/src/rover/run-production.sh"]
