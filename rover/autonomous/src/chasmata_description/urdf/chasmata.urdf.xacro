<?xml version="1.0"?>
<robot name="chasmata" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Base footprint (projection on ground) -->
  <link name="base_footprint"/>

  <!-- Base link (center of the rover body) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.33" ixy="0" ixz="0" iyy="0.63" iyz="0" izz="0.83"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Macro for wheels -->
  <xacro:macro name="wheel" params="prefix x_offset y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <geometry>
          <cylinder radius="0.15" length="0.1"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.15" length="0.1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.022"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_offset} ${y_offset} -0.05" rpy="1.5708 0 0"/>
      <axis xyz="0 0 -1"/>
    </joint>
  </xacro:macro>

  <!-- 4 Wheels -->
  <xacro:wheel prefix="front_left" x_offset="0.25" y_offset="0.25"/>
  <xacro:wheel prefix="front_right" x_offset="0.25" y_offset="-0.25"/>
  <xacro:wheel prefix="rear_left" x_offset="-0.25" y_offset="0.25"/>
  <xacro:wheel prefix="rear_right" x_offset="-0.25" y_offset="-0.25"/>

  <!-- 2D LiDAR Sensor (assumed RPLIDAR A3, mounted upright on top-front of body)
       Position: 0.2 m forward, 0.0 m lateral, 0.125 m above base_link centre
       → which puts it flush with the top surface of the 0.2 m tall body.
       If the physical unit is mounted inverted, change rpy to "3.14159 0 0". -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.1 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <!-- ~170 g — typical for RPLIDAR A3 -->
      <mass value="0.17"/>
      <inertia ixx="0.000058" ixy="0" ixz="0"
               iyy="0.000058" iyz="0"
               izz="0.000106"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- 0.2 m forward, centred laterally, top of rover body -->
    <origin xyz="0.2 0 0.125" rpy="0 0 0"/>
  </joint>

  <!-- IMU Sensor -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
