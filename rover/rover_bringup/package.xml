<?xml version="1.0"?>
<package format="3">
  <name>rover_bringup</name>
  <version>0.1.0</version>
  <description>Rover Control and development/production stack bringup.</description>
  <maintainer email="robotics@example.com">Deakin Competitive Robotics Club</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ecam_alerts</depend>
  <depend>mock_rover</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>telemetry_interfaces</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
