<?xml version="1.0"?>
<launch>
  <arg name="mode" default="dev" description="Rover mode: dev or prod"/>
  <group if="$(eval &quot;'$(var mode)' == 'prod'&quot;)">
    <node pkg="prod_rover" exec="prod_rover" name="prod_rover" output="screen"/>
  </group>
  <node pkg="ecam_alerts" exec="ecam_alert_aggregator" name="ecam_alert_aggregator_rover" output="screen"><param name="role" value="rover"/></node>
  <node pkg="rosbridge_server" exec="rosbridge_websocket" name="rosbridge_websocket" output="screen"><param name="port" value="9090"/></node>
  <group if="$(eval &quot;'$(var mode)' == 'dev'&quot;)">
    <node pkg="mock_rover" exec="mock_rover" name="mock_rover" output="screen"/>
  </group>
</launch>
